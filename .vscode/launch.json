{
  // Run and debug the services on the host (F5). Start the infrastructure
  // first: docker compose up -d
  // Environment variables come from .env, see .env.example.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "tracker-api",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/tracker-api",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "analytics-processor",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/analytics-processor",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "output": "${workspaceFolder}/__debug_bin_analytics-processor-1.exe"
    },
    {
      // Second member of the same consumer group, to see the partitions
      // split between instances and the rebalance when one of them stops.
      // A separate output is required: on Windows a running binary is
      // locked and cannot be rebuilt by the second launch.
      "name": "analytics-processor #2",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/analytics-processor",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "output": "${workspaceFolder}/__debug_bin_analytics-processor-2.exe"
    }
  ],
  "compounds": [
    {
      "name": "analytics-processor x2",
      "configurations": ["analytics-processor", "analytics-processor #2"]
    }
  ]
}
