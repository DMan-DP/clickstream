# Copy to .env and change the values: cp .env.example .env

# PostgreSQL
POSTGRES_USER=clickstream
POSTGRES_PASSWORD=change-me
POSTGRES_DB=clickstream
POSTGRES_PORT=5432

# Kafka
KAFKA_TOPIC=user-events
KAFKA_TOPIC_PARTITIONS=3

# kafka-ui on the host: http://localhost:8090
KAFKA_UI_PORT=8090

# tracker-api on the host. Compose does not use this block: the variables
# are read by the VS Code launch configuration (envFile in .vscode/launch.json)
# or have to be set in the terminal for go run.
HTTP_ADDR=:8080
# localhost:9092 from the host, kafka:29092 from containers in the compose network
KAFKA_BROKERS=localhost:9092
# debug, info, warn or error
LOG_LEVEL=info

# frontend (nginx): the page on the host is http://localhost:3000,
# /events is proxied to tracker-api
FRONTEND_PORT=3000
# tracker-api started on the host with go run; in compose: http://tracker-api:8080
TRACKER_API_URL=http://host.docker.internal:8080
