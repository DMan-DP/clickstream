# Copy to .env and change the values: cp .env.example .env

# PostgreSQL
POSTGRES_USER=clickstream
POSTGRES_PASSWORD=change-me
POSTGRES_DB=clickstream
# Host port. 5433, not 5432: a local PostgreSQL install often holds 5432.
POSTGRES_PORT=5433

# Kafka
KAFKA_TOPIC=user-events
KAFKA_TOPIC_PARTITIONS=3

# kafka-ui on the host: http://localhost:8090
KAFKA_UI_PORT=8090

# tracker-api and analytics-processor run in compose by default and get
# their settings from the services in docker-compose.yml. The block below
# is for a service started on the host: the variables are read by the
# VS Code launch configuration (envFile in .vscode/launch.json) or have to
# be set in the terminal for go run. Compose takes from here only
# KAFKA_TOPIC, LOG_LEVEL, KAFKA_GROUP_ID, WINDOW_SIZE, FLUSH_INTERVAL and
# DB_MAX_CONNS.
HTTP_ADDR=:8080
# localhost:9092 from the host, kafka:29092 from containers in the compose network
KAFKA_BROKERS=localhost:9092
# debug, info, warn or error
LOG_LEVEL=info

# analytics-processor on the host: uses KAFKA_BROKERS, KAFKA_TOPIC and
# LOG_LEVEL from above. Instances with the same group id share the partitions.
KAFKA_GROUP_ID=analytics-processor
# Aggregation window length, Go duration format (30s, 1m). Must be positive
# and a whole number of seconds: the tables store it as window_sec.
WINDOW_SIZE=30s
# How often each partition writes its counts to PostgreSQL and then marks
# the read messages, Go duration format. Must be positive. Smaller means
# fresher data in the tables and more transactions; after a crash the
# events read since the last write are read again.
FLUSH_INTERVAL=5s
# PostgreSQL connection string. User, password and database must match the
# POSTGRES_* values above; localhost from the host, postgres:5432 from
# containers in the compose network.
DATABASE_URL=postgres://clickstream:change-me@localhost:5433/clickstream?sslmode=disable
# Upper limit of the connection pool. One transaction per partition is open
# at the same time, so keep it above KAFKA_TOPIC_PARTITIONS with a margin.
DB_MAX_CONNS=10

# frontend (nginx): the page on the host is http://localhost:3000,
# /events is proxied to tracker-api
FRONTEND_PORT=3000
# Where nginx sends /events: tracker-api in compose. For tracker-api
# started on the host: http://host.docker.internal:8080
TRACKER_API_URL=http://tracker-api:8080

# tracker-api in compose, port on the host for curl
TRACKER_API_PORT=8080
