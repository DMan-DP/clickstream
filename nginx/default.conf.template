# Rendered by the nginx image at start: ${VAR} is replaced with the
# environment variable of the container (envsubst), nginx variables such as
# $host are kept because no environment variable has their name.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Development: files come from a bind mount, edits must show up at once.
    # sendfile on a Docker Desktop bind mount can serve stale content.
    sendfile off;
    add_header Cache-Control "no-cache" always;

    # API on the same origin as the page, so the browser needs no CORS.
    # The body size limit (64 KB, 413) is checked by tracker-api itself.
    location = /events {
        proxy_pass ${TRACKER_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
