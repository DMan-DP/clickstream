# Settings of analytics-processor, Kustomize turns them into the ConfigMap
# "analytics-processor". The same variables as in docker-compose.yml.
# DATABASE_URL is built in analytics-processor.yaml from the Secret.
HTTP_ADDR=:8081
KAFKA_BROKERS=kafka:9092
# Must match the topic created by the kafka-topics Job in kafka.yaml
KAFKA_TOPIC=user-events
KAFKA_GROUP_ID=analytics-processor
WINDOW_SIZE=30s
SESSION_TIMEOUT=30m
FLUSH_INTERVAL=5s
# Per pod: replicas x DB_MAX_CONNS must stay well below max_connections
# of Postgres (100 by default)
DB_MAX_CONNS=10
LOG_LEVEL=info
