# Settings of tracker-api, Kustomize turns them into the ConfigMap
# "tracker-api". The same variables as in docker-compose.yml.
HTTP_ADDR=:8080
# Pause between SIGTERM and the server shutdown: the server keeps
# accepting requests until kube-proxy on every node has dropped the pod,
# so late requests get an answer instead of connection refused
SHUTDOWN_DELAY=5s
KAFKA_BROKERS=kafka:9092
# Must match the topic created by the kafka-topics Job in kafka.yaml
KAFKA_TOPIC=user-events
LOG_LEVEL=info
