# Copy to secrets.env and change the password:
#   cp deploy/k8s/secrets.env.example deploy/k8s/secrets.env
# secrets.env is not committed. Kustomize turns it into the Secret "postgres".
# The password goes into DATABASE_URL as is, so use only letters and digits.
POSTGRES_USER=clickstream
POSTGRES_PASSWORD=changeme
POSTGRES_DB=clickstream
