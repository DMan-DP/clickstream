# Copy to postgres.secret.env and change the password:
#   cp deploy/k8s/postgres.secret.env.example deploy/k8s/postgres.secret.env
# Files *.secret.env are not committed. Kustomize turns this one into the
# Secret "postgres" (database credentials for Postgres, the migrate Job and
# analytics-processor).
# The password goes into DATABASE_URL as is, so use only letters and digits.
POSTGRES_USER=clickstream
POSTGRES_PASSWORD=changeme
POSTGRES_DB=clickstream
